<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HybridFileXfer.Gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:engine="using:HybridFileXfer.EngineClient"
    xmlns:local="using:HybridFileXfer.Gui"
    Title="多轨快传 GUI">

    <Grid x:Name="RootGrid" Padding="16" RowSpacing="8" Loaded="RootGrid_Loaded">
        <Grid.Resources>
            <DataTemplate x:Key="FileItemTemplate" x:DataType="engine:RemoteEntry">
                <Grid ColumnSpacing="8" MinHeight="34" Padding="4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind Glyph}"
                              FontSize="16"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind DisplayName}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2"
                               Text="{x:Bind DisplaySize}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="3"
                               Text="{x:Bind DisplayTime}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="190" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16">
            <TextBlock Text="多轨快传"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Text="WinUI 3 文件管理"
                       VerticalAlignment="Bottom"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       VerticalAlignment="Bottom"
                       FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind ViewModel.SpeedText, Mode=OneWay}"
                       VerticalAlignment="Bottom"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Channels, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="4"
                                Padding="8,1">
                            <TextBlock Text="{Binding}" FontSize="12" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Expander x:Name="ConnectionExpander" Grid.Row="1" Header="连接设置" IsExpanded="True">
            <StackPanel Spacing="6" Padding="0,4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="ModeBox"
                              Header="模式"
                              Width="100"
                              SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="ADB" />
                        <ComboBoxItem Content="IP" />
                    </ComboBox>
                    <TextBox x:Name="AddressBox"
                             Header="地址（IP 模式）"
                             Width="200"
                             Text="{x:Bind ViewModel.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox x:Name="PortBox"
                             Header="端口"
                             Width="90"
                             Text="{x:Bind ViewModel.Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox x:Name="HomeDirBox"
                             Header="PC 主目录"
                             Width="300"
                             Text="{x:Bind ViewModel.HomeDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button x:Name="ConnectButton"
                            Content="连接"
                            Click="ConnectButton_Click"
                            IsEnabled="{x:Bind ViewModel.CanConnect, Mode=OneWay}"
                            VerticalAlignment="Bottom" />
                    <Button x:Name="DisconnectButton"
                            Content="断开"
                            Click="DisconnectButton_Click"
                            IsEnabled="{x:Bind ViewModel.CanDisconnect, Mode=OneWay}"
                            VerticalAlignment="Bottom" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="JavaBox"
                             Header="Java"
                             Width="220"
                             Text="{x:Bind ViewModel.JavaPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox x:Name="AdbBox"
                             Header="adb（文件或目录）"
                             Width="360"
                             Text="{x:Bind ViewModel.AdbPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
        </Expander>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 本机 -->
            <Grid Grid.Column="0" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="本机"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="LocalPathBox"
                             Grid.Column="1"
                             Text="{x:Bind ViewModel.LocalPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="LocalPath_KeyDown"
                             PlaceholderText="路径或「此电脑」" />
                    <Button x:Name="LocalUpButton" Grid.Column="2" Content="上一级" Click="LocalUp_Click" />
                    <Button x:Name="LocalRefreshButton" Grid.Column="3" Content="刷新" Click="LocalRefresh_Click" />
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="UploadButton"
                            Content="上传到手机 →"
                            Click="UploadButton_Click"
                            IsEnabled="{x:Bind ViewModel.CanRemoteOperate, Mode=OneWay}" />
                    <Button x:Name="LocalNewFolderButton"
                            Content="新建文件夹"
                            Click="LocalNewFolder_Click"
                            IsEnabled="{x:Bind ViewModel.CanLocalOperate, Mode=OneWay}" />
                    <Button x:Name="LocalDeleteButton"
                            Content="删除"
                            Click="LocalDelete_Click"
                            IsEnabled="{x:Bind ViewModel.CanLocalOperate, Mode=OneWay}" />
                </StackPanel>

                <ListView x:Name="LocalList"
                          Grid.Row="2"
                          ItemsSource="{x:Bind ViewModel.LocalEntries, Mode=OneWay}"
                          ItemTemplate="{StaticResource FileItemTemplate}"
                          SelectionMode="Extended"
                          DoubleTapped="LocalList_DoubleTapped" />

                <TextBlock Grid.Row="3"
                           Text="{x:Bind ViewModel.LocalCount, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <!-- 手机 -->
            <Grid Grid.Column="1" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="手机"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="RemotePathBox"
                             Grid.Column="1"
                             Text="{x:Bind ViewModel.RemotePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="RemotePath_KeyDown"
                             PlaceholderText="手机路径，如 /sdcard" />
                    <Button x:Name="RemoteUpButton" Grid.Column="2" Content="上一级" Click="RemoteUp_Click" />
                    <Button x:Name="RemoteRefreshButton" Grid.Column="3" Content="刷新" Click="RemoteRefresh_Click" />
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="DownloadButton"
                            Content="← 下载到本机"
                            Click="DownloadButton_Click"
                            IsEnabled="{x:Bind ViewModel.CanRemoteOperate, Mode=OneWay}" />
                    <Button x:Name="RemoteNewFolderButton"
                            Content="新建文件夹"
                            Click="RemoteNewFolder_Click"
                            IsEnabled="{x:Bind ViewModel.CanRemoteOperate, Mode=OneWay}" />
                    <Button x:Name="RemoteDeleteButton"
                            Content="删除"
                            Click="RemoteDelete_Click"
                            IsEnabled="{x:Bind ViewModel.CanRemoteOperate, Mode=OneWay}" />
                </StackPanel>

                <ListView x:Name="RemoteList"
                          Grid.Row="2"
                          ItemsSource="{x:Bind ViewModel.RemoteEntries, Mode=OneWay}"
                          ItemTemplate="{StaticResource FileItemTemplate}"
                          SelectionMode="Extended"
                          DoubleTapped="RemoteList_DoubleTapped" />

                <TextBlock Grid.Row="3"
                           Text="{x:Bind ViewModel.RemoteCount, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="传输队列" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="取消等待"
                            Click="CancelPending_Click"
                            Padding="8,2"
                            FontSize="12" />
                </StackPanel>
                <ListView x:Name="TransferList"
                          Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.TransferJobs, Mode=OneWay}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:TransferJob">
                            <Grid ColumnSpacing="8" MinHeight="46" Padding="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind DirectionText}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayName}"
                                               TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Value="{x:Bind Percent, Mode=OneWay}"
                                                 Height="4"
                                                 Maximum="100" />
                                    <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind SpeedText, Mode=OneWay}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Message, Mode=OneWay}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="1" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="日志" FontWeight="SemiBold" />
                <TextBox Grid.Row="1"
                         Text="{x:Bind ViewModel.LogText, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontFamily="Consolas"
                         FontSize="11"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>
    </Grid>
</Window>
